# Git
.git
.gitignore
.github

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
*.egg-info/

# Frontend dependencies and temp files (stage 1 installs cleanly)
frontend/node_modules/
frontend/.vite/
frontend/dist/

# Logs and environment
*.log
.env
.env.local
.env.*.local

# Job outputs and test data
output/api_jobs/*
!output/api_jobs/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Testing and development artifacts
tests/
notebooks/
reports/
