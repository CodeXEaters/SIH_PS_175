# =============================================================================
# DepthWizard Environment Configuration
# Copy this file to .env and adjust values as needed.
# =============================================================================

# --- Backend Model Configuration ---
# Path to the Depth Anything V2 TorchScript (.pt) checkpoint.
# Default if unset: models/checkpoints/depth_anything_v2_vits.pt
DEPTH_CHECKPOINT=models/checkpoints/depth_anything_v2_vits.pt

# --- Backend Storage & Upload Limits ---
# Directory where uploaded files and processing results are stored.
# Default if unset: output/api_jobs
API_STORAGE_DIR=output/api_jobs

# Maximum allowed upload size in bytes (default: 52428800 = 50 MB).
API_MAX_UPLOAD_BYTES=52428800

# Comma-separated list of allowed origins for CORS.
# Default if unset: *
API_CORS_ORIGINS=*

# --- Frontend Configuration (used by Vite dev server / build) ---
# Base URL for the FastAPI backend.
VITE_API_URL=http://localhost:8000
